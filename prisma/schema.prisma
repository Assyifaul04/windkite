generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMERATIONS (Tipe Data Standar)
// ==========================================

enum Role {
  USER
  ADMIN
}

enum KiteSuitability {
  TIDAK_LAYAK
  RINGAN
  BERAT
  SEMUA
}

enum KiteFrameStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KiteDesignStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// TABEL AUTENTIKASI (Google OAuth - NextAuth)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  savedLocations SavedLocation[]
  weatherLogs    WeatherLog[]
  kiteDesigns    KiteDesign[]
  kiteFrames     KiteFrame[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// TABEL WILAYAH & DATA CUACA ANGIN
// ==========================================

model SavedLocation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  latitude  Float
  longitude Float
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weatherLogs WeatherLog[]

  @@map("saved_locations")
}

model WeatherLog {
  id            String   @id @default(cuid())
  locationId    String   @map("location_id")
  userId        String?  @map("user_id")
  timestamp     DateTime @default(now())

  windSpeed     Float    @map("wind_speed")
  windGust      Float    @map("wind_gust")
  windDirection Float    @map("wind_direction")
  temperature   Float?
  humidity      Float?

  kiteSuitability KiteSuitability @default(TIDAK_LAYAK) @map("kite_suitability")

  location SavedLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([locationId, timestamp]) 
  @@map("weather_logs")
}

// ==========================================
// TABEL TEMPLATE KERANGKA LAYANGAN (Admin)
// ==========================================

model KiteFrame {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  description  String?  @db.Text
  imageUrl     String   @map("image_url") @db.Text 
  thumbnailUrl String?  @map("thumbnail_url") @db.Text
  
  // Resolusi kanvas asli saat admin membuat marker
  canvasWidth  Float?   @map("canvas_width") 
  canvasHeight Float?   @map("canvas_height")
  
  // ==========================================
  // FITUR MARKER (MASKING PATH)
  // ==========================================
  // markerData menyimpan raw JSON dari titik merah (X, Y, tipe curve/line) seperti di image_6c3d6c.png
  markerData   Json?    @map("marker_data") 
  
  // clipPathSvg menyimpan hasil compile string SVG (misal: "M10,10 L50,10 C... Z") untuk dipasang di CSS clip-path
  clipPathSvg  String?  @map("clip_path_svg") @db.Text 
  
  status       KiteFrameStatus @default(DRAFT)
  isPublic     Boolean  @default(false)
  viewCount    Int      @default(0)
  useCount     Int      @default(0)
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  designs      KiteDesign[]

  @@index([status, isPublic])
  @@map("kite_frames")
}

// ==========================================
// TABEL DESAIN LAYANGAN (User mengupload sampul)
// ==========================================

model KiteDesign {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  frameId         String   @map("frame_id") 
  
  coverImageUrl   String   @map("cover_image_url") @db.Text
  thumbnailUrl    String?  @map("thumbnail_url") @db.Text
  finalImageUrl   String?  @map("final_image_url") @db.Text
  
  title           String?
  description     String?  @db.Text

  // ==========================================
  // FITUR TRANSFORMASI GAMBAR USER (DI DALAM MARKER)
  // ==========================================
  positionX       Float?   @default(0) @map("position_x") // Posisi X gambar (pan/geser horizontal)
  positionY       Float?   @default(0) @map("position_y") // Posisi Y gambar (pan/geser vertikal)
  scale           Float?   @default(1.0)                  // Zoom In / Zoom Out
  rotation        Float?   @default(0)                    // Rotasi gambar (derajat)
  width           Float?                                  // Ukuran asli dimensi gambar user
  height          Float?
  
  status          KiteDesignStatus @default(PENDING)
  isPublic        Boolean  @default(false)
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame           KiteFrame   @relation(fields: [frameId], references: [id], onDelete: Cascade)
  storageFile     StorageFile?

  @@index([userId, frameId])
  @@index([status])
  @@map("kite_designs")
}

// ==========================================
// TABEL STORAGE FILE
// ==========================================

model StorageFile {
  id          String   @id @default(cuid())
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  storageType String   @default("temporary") @map("storage_type")
  source      String   
  
  kiteDesignId String? @unique @map("kite_design_id")
  
  expiresAt   DateTime? @map("expires_at")
  archivedAt  DateTime? @map("archived_at")
  
  driveFileId   String? @map("drive_file_id")
  driveFolderId String? @map("drive_folder_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  kiteDesign  KiteDesign? @relation(fields: [kiteDesignId], references: [id])

  @@index([storageType, expiresAt])
  @@index([source])
  @@index([driveFileId])
  @@map("storage_files")
}

// ==========================================
// TABEL SETTINGS
// ==========================================

model CronJob {
  id             String   @id @default(cuid())
  name           String
  description    String?
  schedule       String
  command        String
  status         String   @default("active")
  lastRun        DateTime?
  nextRun        DateTime
  runs           Int      @default(0)
  successfulRuns Int      @default(0)
  failedRuns     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("cron_jobs")
}

model WeatherSettings {
  id              String   @id @default(cuid())
  provider        String   @default("openweather")
  apiKey          String?  @map("api_key")
  apiUrl          String   @default("https://api.openweathermap.org/data/2.5") @map("api_url")
  defaultLocation String   @default("Jakarta") @map("default_location")
  cacheDuration   Int      @default(300) @map("cache_duration")
  autoUpdate      Boolean  @default(true) @map("auto_update")
  updateInterval  Int      @default(3600) @map("update_interval")
  retryCount      Int      @default(3) @map("retry_count")
  timeout         Int      @default(5000)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("weather_settings")
}

// ==========================================
// TABEL STORAGE SETTINGS
// ==========================================

model StorageSettings {
  id                  String   @id @default(cuid())
  provider            String   @default("neon")
  databaseUrl         String?
  databaseName        String   @default("windkite_db")
  
  storageEndpoint     String?  @map("storage_endpoint")
  storageBucket       String   @default("kite-designs") @map("storage_bucket")
  storageUrl          String?  @map("storage_url")
  accessKey           String?  @map("access_key")
  secretKey           String?  @map("secret_key")
  region              String   @default("us-east-2")
  
  autoBackup          Boolean  @default(true) @map("auto_backup")
  backupSchedule      String   @default("daily") @map("backup_schedule")
  retentionDays       Int      @default(30) @map("retention_days")
  compressImages      Boolean  @default(true) @map("compress_images")
  maxUploadSize       Int      @default(10) @map("max_upload_size")
  
  googleDriveFolderId String?  @map("google_drive_folder_id")
  autoMoveToDrive     Boolean  @default(true) @map("auto_move_to_drive")
  tempStorageDays     Int      @default(7) @map("temp_storage_days")
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("storage_settings")
}